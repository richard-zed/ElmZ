// elmz -- shipped theme defaults.
//
// This is the listing, not a backup: it is compiled into the library and is
// what an app's own theme.zon starts from. Copy it, delete what you do not
// want to change, and the rest inherits.
//
// Colours are 0xRRGGBB. A .zon is literal data -- no expressions, no calls --
// so a token can never be spelled here. Values may only be derived in a
// resolve step, at load time.
//
// Roles are not widgets. `panel` is "the fill of a raised area", not "a card",
// which is what lets one token serve panels, rows and list items.
//
// Two sections, never merged:
//   .theme -- the ten portable roles below. Same meaning in every elmz app.
//   .app   -- tokens this app declared for itself, in Zig. Not present here,
//             because it is the app's to define.
.{
    .version = 1,

    .theme = .{
        // page background; the colour a backend clears to
        .bg = 0x1e1e2e,
        // raised or inset fill: panels, cards, rows
        .panel = 0x313244,
        // outlines and dividers
        .border = 0x9399b2,
        // primary text
        .text = 0xcdd6f4,
        // secondary text: captions, hints, units
        .text_muted = 0xa6adc8,
        // resting fill of an interactive control
        .control = 0x45475a,
        // control fill under the pointer
        .hover = 0x6c7086,
        // control fill while that control owns the press
        .pressed = 0x7f849c,
        // this item is the chosen one among its peers
        .selected = 0x585b70,
        // emphasis: active borders, markers, value fills
        .accent = 0x89b4fa,
    },
}
