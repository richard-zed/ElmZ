// elmz -- shipped theme defaults.
//
// This is the listing, not a backup: it is compiled into the library and is
// what an app's own theme.zon starts from. Copy it, delete what you do not
// want to change, and the rest inherits.
//
// This file is DATA. A .zon cannot contain an expression, a call or an import
// -- the parser rejects all three -- so a theme can never compute a colour or
// reach outside itself. Everything here is a literal.
//
// Colours are 0xRRGGBB. Roles are not widgets: `panel` means "the fill of a
// raised area", not "a card", which is what lets one token serve panels, rows
// and list items.
//
// Two sections, never merged:
//   .theme -- the ten portable roles. Same meaning in every elmz app.
//   .vars  -- tokens an app declared for itself, in Zig. Absent here, because
//             it is the app's to define; a file that writes one without
//             declaring it is rejected rather than ignored.
//
// .theme has two halves, and each has the syntax its data wants:
//   .colors    -- ten hex roles. Omit any to inherit.
//   .gradients -- optional, per role. A role listed here overrides the flat
//                 colour everywhere that role is used as a FILL. Gradients are
//                 literal too, so they do not follow a later edit to .colors.
.{
    .version = 3,

    .theme = .{
        .colors = .{
            // page background; the colour a backend clears to
            .bg = 0x1e1e2e,
            // raised or inset fill: panels, cards, rows
            .panel = 0x313244,
            // outlines and dividers
            .border = 0x9399b2,
            // primary text
            .text = 0xcdd6f4,
            // secondary text: captions, hints, units
            .text_muted = 0xa6adc8,
            // resting fill of an interactive control
            .control = 0x45475a,
            // control fill under the pointer
            .hover = 0x6c7086,
            // control fill while that control owns the press
            .pressed = 0x7f849c,
            // this item is the chosen one among its peers
            .selected = 0x585b70,
            // emphasis: active borders, markers, value fills
            .accent = 0x89b4fa,
            // a thing worked: a success toast's bar, a passing check
            .success = 0xa6e3a1,
            // still working, wants attention: a warning toast's bar
            .warning = 0xf9e2af,
            // a thing failed: the error band's text, an error toast's bar
            .fail = 0xf38ba8,

            // Colours beyond the ten. A LIST, not a map -- zon has no map.
            //
            // This is the tier for what a UI needs but a palette cannot
            // guess: a diff's added and removed, a chart's series, a tag's
            // hue. Each is usable anywhere a role name is -- `.bg = "danger"`,
            // a halo's `.color`, a `.gradients` key.
            //
            // A custom name may NOT shadow one above: the built-in would win
            // the lookup, so the file would look ignored rather than wrong.
            //
            // .roles = .{
            //     .{ .name = "danger", .hex = 0xeba0ac },
            //     .{ .name = "info", .hex = 0x89dceb },
            // },
        },

        // No gradient ships by default: a default gradient is a look, and the
        // library's default look is a flat palette.
        //
        // Keyed by ROLE NAME -- the ten built-ins or any `.roles` above -- so
        // a gradient stands exactly where a flat colour would. A gradient
        // overrides that role wherever it is used as a FILL; the flat colour
        // stays for text and borders, and as the fallback.
        //
        // Omitted ends INHERIT the role's resolved colour, so a gradient
        // cannot drift from the palette it belongs to. Here `.accent`'s `from`
        // is simply 0x89b4fa without repeating it.
        //
        // `.dir` is DEGREES, clockwise from 12 o'clock: 0 up, 90 right,
        // 180 down, 270 left. Radial `.center` is a fraction of the box;
        // `.radius` is a fraction of its WIDTH.
        //
        // .gradients = .{
        //     .accent = .{ .linear = .{ .dir = 135, .to = 0xf5c2e7 } },
        //     .panel = .{ .radial = .{ .inner = 0x45475a, .center = .{ 0.25, 0.15 }, .radius = 0.7 } },
        //     .danger = .{ .linear = .{ .dir = 90, .from = 0xeba0ac, .to = 0xf38ba8 } },
        // },
        //
        // Custom gradients go in a `roles` list inside `.gradients`, naming a
        // colour from `.colors .roles`. A gradient for a name no role defines
        // is rejected: it would resolve against the `text` fallback and draw a
        // ramp nobody asked for.
        //
        // .gradients = .{
        //     .roles = .{
        //         .{ .name = "danger", .gradient = .{ .linear = .{ .dir = 90, .to = 0xf38ba8 } } },
        //     },
        // },
    },

    // Named styles: a role reference per slot, resolved against THIS file's
    // palette. A style names a ROLE, not a colour, so editing `.colors` moves
    // every style that uses it and a style can never drift from the palette.
    //
    // The `font` below is a style's way of naming a typeface. Each script needs
    // its own face: a Latin face has no Arabic, Thai or CJK glyphs, and the
    // three CJK languages do NOT share one either -- they agree on most
    // characters and disagree on exactly the ones a reader would notice.
    //
    // A style may also carry:
    //   .size   -- point size, which a call site passing its own `.size` beats
    //   .weight -- the variable `wght` axis (400, 700). A no-op on a static
    //              face, and `Ubuntu` below IS static, so the comments here
    //              use a variable name where weight matters.
    //   .halo   -- a glow or shadow, in the role names above. Colour is a ROLE
    //              so it follows `.colors`. A shadow is not a separate thing:
    //              it is `.mode = "outer_glow"` plus an `.offset` plus a dark
    //              role. `.light` is the clock-face angle the light COMES
    //              FROM (0 overhead, 90 right) -- note that a `.dir` in
    //              `.gradients` is where the colour GOES, the opposite sense
    //              at the same number.
    .styles = .{
        .{ .name = "latin", .spec = .{ .fg = "text", .font = "Ubuntu" } },
        // .{ .name = "heading", .spec = .{
        //     .fg = "text",
        //     .font = "Roboto Flex",
        //     .size = 34,
        //     .weight = 700,
        //     .halo = .{ .color = "accent", .blur = 14, .spread = 2, .light = 0 },
        // } },
        // .{ .name = "card", .spec = .{
        //     .bg = "panel",
        //     .halo = .{ .color = "bg", .blur = 10, .offset = .{ 0, 6 }, .mode = "outer_glow" },
        // } },
        .{ .name = "arabic", .spec = .{ .fg = "text", .font = "Noto Sans Arabic" } },
        .{ .name = "thai", .spec = .{ .fg = "text", .font = "Noto Sans Thai" } },
        // The three CJK languages live in ONE collection file, so the name is
        // the file and the language is chosen by index -- see `face_index`.
        .{ .name = "chinese", .spec = .{ .fg = "text", .font = "Noto Sans CJK SC" } },
        .{ .name = "japanese", .spec = .{ .fg = "text", .font = "Noto Sans CJK JP" } },
        .{ .name = "korean", .spec = .{ .fg = "text", .font = "Noto Sans CJK KR" } },
    },
}
