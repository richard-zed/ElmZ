.{
    .version = 3,

    // The library's house palette. Flat by design: a default gradient is a
    // look, and a library should not arrive with one. An app that wants
    // gradients puts them in its own theme.zon.
    //
    // Colours are written BARE -- `0xRRGGBB`, not `.{ .hex = ... }` -- because
    // a colour is one value, and the file decides its shape rather than
    // naming a form. `.{ r, g, b }` and `.{ f, f, f }` (fractions) work too.
    .theme = .{
        .colors = .{
            .bg = 0x1e1e2e,
            .panel = 0x313244,
            .border = 0x9399b2,
            .text = 0xcdd6f4,
            .text_muted = 0xa6adc8,
            .control = 0x45475a,
            .hover = 0x6c7086,
            .pressed = 0x7f849c,
            .selected = 0x585b70,
            .accent = 0x89b4fa,
            .success = 0xa6e3a1,
            .warning = 0xf9e2af,
            .fail = 0xf38ba8,
        },
    },

    // One style per script, plus a heading and a card. `latin` carries no
    // weight on purpose: omitted means "whatever the face says", not 400, so
    // a replacement face is not silently forced to a weight nobody chose.
    // A heavy default here would also make every app's body text heavy before
    // the app asked for anything.
    //
    // A style's role references are ENUM LITERALS -- `.color = .text` -- so
    // the reference and the role it names cannot drift apart, and an edit to
    // the palette moves every style that points at it.
    .styles = .{
        .latin = .{ .color = .text, .font = "Roboto Flex" },
        .arabic = .{ .color = .text, .font = "Noto Sans Arabic" },
        .thai = .{ .color = .text, .font = "Noto Sans Thai" },
        .chinese = .{ .color = .text, .font = "Noto Sans CJK SC" },
        .japanese = .{ .color = .text, .font = "Noto Sans CJK JP" },
        .korean = .{ .color = .text, .font = "Noto Sans CJK KR" },

        .heading = .{ .color = .text, .font = "Roboto Flex", .size = 34, .weight = 800 },
        .card = .{
            .bg = .panel,
            .border = .border,
            .halo = .{ .color = .bg, .blur = 10, .offset = .{ 0, 6 }, .mode = .outer_glow },
        },
    },
}
