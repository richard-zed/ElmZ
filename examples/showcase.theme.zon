// This is the file that ships as the project's live `theme.zon` (both are in
// the project root, next to build.zig, which is where every example run step
// looks because their cwd is pinned there).
//
// Edit `theme.zon` and rerun -- or leave the window open and save, since the
// runner stats the file once per loop. `zig build theme` restores this copy,
// so it is also the reset button.
//
// Every role is optional -- an omitted one inherits the library default, so
// this file could list only `.accent` and still be legal.
//
// `version` must be 2. A v1 file (flat `.theme`, no `.colors`) is refused with
// one sentence rather than half-read, because the half-read version looks like
// "my theme did nothing".
.{
    .version = 2,
    .theme = .{
        .colors = .{
            .bg = 0x1f1a14,
            .panel = 0x2b241b,
            .border = 0x8a7a63,
            .text = 0xf2e6d8,
            .text_muted = 0xb9a892,
            .control = 0x3a3126,
            .hover = 0x5c4f3d,
            .pressed = 0x6f6049,
            .selected = 0x473b2c,
            .accent = 0xe0b060,
        },

        // Gradients are per role and optional: every place the role is used as
        // a FILL picks this up, and the `.colors` entry above stays as the
        // fallback and for text and borders.
        //
        // `from` is omitted on purpose. An omitted end inherits the role's own
        // colour, so this follows `.accent` if you edit it above -- name only
        // the end that differs and the gradient cannot drift from the palette.
        .gradients = .{
            .accent = .{ .linear = .{ .dir = .horizontal, .to = 0x8a5a2b } },
            .panel = .{ .radial = .{ .outer = 0x1f1a14, .radius = 0.7 } },
        },
    },
}
